<%- include('../partials/header', { pageTitle: pageTitle }) %>

<div class="card" style="max-width: 600px; margin: 1.5rem auto; padding: 20px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px;">
    <h2>Formulir Edit Data Produk</h2>
    <form action="/produk/edit/<%= produk.id %>" method="POST" style="margin-top: 1.5rem;">
        
        <div style="margin-bottom: 1rem;">
            <label for="nama_produk" style="display: block; margin-bottom: 0.5rem; font-weight: bold;">Nama Produk:</label>
            <input type="text" id="nama_produk" name="nama_produk" value="<%= produk.nama_produk %>" required style="width: 100%; padding: 0.5rem; border: 1px solid #cbd5e1; border-radius: 4px;">
        </div>

        <div style="margin-bottom: 1rem;">
            <label for="kategori" style="display: block; margin-bottom: 0.5rem; font-weight: bold;">Kategori:</label>
            <input type="text" id="kategori" name="kategori" value="<%= produk.kategori %>" required style="width: 100%; padding: 0.5rem; border: 1px solid #cbd5e1; border-radius: 4px;">
        </div>

        <div style="margin-bottom: 1rem;">
            <label for="harga" style="display: block; margin-bottom: 0.5rem; font-weight: bold;">Harga (Rp):</label>
            <input type="number" id="harga" name="harga" step="0.01" value="<%= produk.harga %>" required style="width: 100%; padding: 0.5rem; border: 1px solid #cbd5e1; border-radius: 4px;">
        </div>

        <div style="margin-bottom: 1.5rem;">
            <label for="stok" style="display: block; margin-bottom: 0.5rem; font-weight: bold;">Stok:</label>
            <input type="number" id="stok" name="stok" value="<%= produk.stok %>" required style="width: 100%; padding: 0.5rem; border: 1px solid #cbd5e1; border-radius: 4px;">
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center;">
            <a href="/produk" style="color: #64748b; text-decoration: none;">&larr; Batal</a>
            <button type="submit" style="background: #2563eb; color: white; padding: 0.5rem 1.25rem; border: none; border-radius: 4px; cursor: pointer; font-weight: bold;">Simpan Perubahan</button>
        </div>

    </form>
</div>

<%- include('../partials/footer') %>